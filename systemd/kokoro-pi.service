[Unit]
Description=kokoro-pi resident text to speech service
Documentation=https://github.com/zreecespieces/kokoro-pi
After=network.target

[Service]
Type=simple
Environment=PYTHONPATH=@SOURCE@/src
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENV@/bin/python -m kokoro_pi serve --models @MODELS@ --port @PORT@ --threads @THREADS@ @SERVE_ARGS@
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@MODELS@

[Install]
WantedBy=default.target
